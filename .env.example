# Smart Pet Feeder Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================
# Application Mode
# ============================================
# MODE options: SIMULATOR or REAL
# SIMULATOR: Run without hardware (for testing/demo)
# REAL: Connect to real ESP32 device and database
MODE=SIMULATOR

# ============================================
# MQTT Configuration
# ============================================
MQTT_BROKER=119.59.99.155
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=smart_pet_feeder_app

# MQTT Topics
MQTT_TOPIC_CONTROL=IoT/project/control
MQTT_TOPIC_MONITORING=IoT/project/monitoring

# ============================================
# Database Configuration
# ============================================
# Only used in REAL mode
DB_HOST=119.59.99.155
DB_PORT=3306
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=your_database

# ============================================
# Hardware Configuration
# ============================================
# Food capacity in grams
FOOD_CAPACITY=3000

# Weight thresholds for UI icons (grams)
WEIGHT_THRESHOLD_EMPTY=0
WEIGHT_THRESHOLD_MID=1500
WEIGHT_THRESHOLD_FULL=3000

# Update interval in milliseconds
UI_UPDATE_INTERVAL=5000

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FILE=smart_pet_feeder.log

# ============================================
# UI Configuration
# ============================================
# Icon paths (relative to project root or absolute)
# Leave empty to use default icons
ICON_PATH_FOOD_EMPTY=
ICON_PATH_FOOD_FULL=
ICON_PATH_FEEDER_EMPTY=
ICON_PATH_FEEDER_MID=
ICON_PATH_FEEDER_FULL=
