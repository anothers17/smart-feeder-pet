# Smart Pet Feeder - Docker Configuration
# Use this configuration when running with docker-compose

# ============================================
# Application Mode
# ============================================
MODE=REAL

# ============================================
# MQTT Configuration (Docker services)
# ============================================
MQTT_BROKER=mqtt
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=smart_pet_feeder_app

# MQTT Topics
MQTT_TOPIC_CONTROL=IoT/project/control
MQTT_TOPIC_MONITORING=IoT/project/monitoring

# ============================================
# Database Configuration (Docker services)
# ============================================
DB_HOST=database
DB_PORT=3306
DB_USER=feeder_user
DB_PASSWORD=smartfeeder123
DB_NAME=smart_pet_feeder

# ============================================
# Hardware Configuration
# ============================================
FOOD_CAPACITY=3000
WEIGHT_THRESHOLD_EMPTY=0
WEIGHT_THRESHOLD_MID=1500
WEIGHT_THRESHOLD_FULL=3000
UI_UPDATE_INTERVAL=5000

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FILE=smart_pet_feeder.log

# ============================================
# UI Configuration
# ============================================
ICON_PATH_FOOD_EMPTY=
ICON_PATH_FOOD_FULL=
ICON_PATH_FEEDER_EMPTY=
ICON_PATH_FEEDER_MID=
ICON_PATH_FEEDER_FULL=
