    },
    {
        "id": "c55d2b25b7f66b62",
        "type": "function",
        "z": "fa545ac33f1808b3",
        "name": "function data food",
        "func": "let data_in = msg.payload;\n\nlet msg1 = { payload: data_in[\"food_weight\"], topic: \"food_weight\" };\nlet msg2 = { payload: data_in[\"amount\"], topic: \"amount\" };\nlet msg3 = { payload: data_in[\"status_amount\"], topic: \"status_amount\" };\n\nlet audio = null; // กำหนดค่าเริ่มต้นเป็น null เพื่อป้องกันปัญหา\n\nif (data_in.status_amount === \"empty\") {\n    audio = { payload: \"empty\" }; \n} else {\n    audio = null\n}\n\nreturn [msg1, msg2, msg3, audio]; // ถ้าไม่ใช่ \"empty\" จะส่ง null ไปที่ Output 4\n\n",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 650,
