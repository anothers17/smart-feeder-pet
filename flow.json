    {
        "id": "555c1a34e7f2c1fe",
        "type": "function",
        "z": "fa545ac33f1808b3",
        "name": "Data food",
        "func": "let din = msg.payload\n\n\nmsg.payload.food_weight = din['food_weight']\n\nmsg.payload.weight = din['amount']\n\nmsg.payload.status_amount = din['status_mount']\n\n\nreturn msg;\n\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 200,
        "wires": [
